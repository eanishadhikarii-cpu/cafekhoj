# ============================================================
# CafeKhoj Backend — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Django Core ---
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production-secure-random-key-cafekhoj

# Set to False in production. True only for local development.
DEBUG=True

# Comma-separated list of allowed hostnames.
# Production example: api.cafekhoj.np,cafekhoj-backend.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave blank to use SQLite (local dev only).
# Production: postgres://user:password@host:5432/dbname
DATABASE_URL=

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Production example: https://cafekhoj.np,https://www.cafekhoj.np
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- CSRF ---
# Required for Django admin over HTTPS. Set to your production backend domain.
# Production example: https://api.cafekhoj.np
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- HTTPS / Secure Cookies (set all to True in production with HTTPS) ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
