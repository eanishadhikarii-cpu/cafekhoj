# ============================================================
# CafeKhoj Backend — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Django Core ---
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-in-production-secure-random-key-cafekhoj

# Set to False in production. True only for local development.
DEBUG=False

# Comma-separated list of allowed hostnames.
# Production example: cafekhoj-api.onrender.com,api.cafekhoj.np
ALLOWED_HOSTS=cafekhoj-api.onrender.com,localhost,127.0.0.1

# --- Database ---
# Supabase PostgreSQL connection string (Transaction Pooler or Direct):
# postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- CORS & CSRF ---
# Comma-separated list of allowed frontend origins.
# Production frontend: https://cafekhoj.vercel.app
CORS_ALLOWED_ORIGINS=https://cafekhoj.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://cafekhoj-api.onrender.com,https://cafekhoj.vercel.app

# --- HTTPS / Secure Cookies (set all to True in production with HTTPS) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- Email & OTP Delivery Configuration ---
# Use django.core.mail.backends.smtp.EmailBackend in production with verified SMTP credentials.
# Console backend is used automatically in DEBUG=True when credentials are empty.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CafeKhoj Registration <registration@cafekhoj.np>
EMAIL_TIMEOUT=10
SUPPORT_EMAIL=support@cafekhoj.np

# --- Google Places API Integration ---
# Official server-side Google Places / Maps API key for fetching authentic ratings and place data.
# When omitted, system safely falls back to "Rating unavailable" without throwing errors.
GOOGLE_PLACES_API_KEY=

# --- Operator Security & Device Policy ---
# Maximum concurrent active devices per Cafe Operator session (default: 1)
MAX_AUTHORIZED_DEVICES_PER_OPERATOR=1

# --- Platform Administrator Bootstrap ---
# Used exclusively by 'python manage.py bootstrap_admin' to provision the single primary platform owner.
# Maximum allowable platform administrators across the entire application is strictly 2.
MAX_PLATFORM_ADMINISTRATORS=2
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
