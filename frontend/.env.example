# ============================================================
# CafeKhoj Frontend — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# API base URL.
# Local development: leave as /api/v1 — the Vite dev proxy forwards to Django.
# Production (Vercel): set to your absolute backend URL, e.g.:
#   VITE_API_URL=https://api.cafekhoj.np/api/v1
VITE_API_URL=/api/v1

VITE_APP_NAME="CafeKhoj"
VITE_DEFAULT_CITY="Birtamode"
